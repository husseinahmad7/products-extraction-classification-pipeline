      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "const": "taxonomy/v1",
      "default": "taxonomy/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "nodes"
